# Copiar para .env.local e preencher. Nenhum destes valores entra no repositório.

# URL público do site — usado no sitemap, no robots.txt e nos URLs canónicos.
NEXT_PUBLIC_SITE_URL=https://exemplo.co.mz

# Envio do formulário de contacto.
# Sem estas variáveis o formulário devolve um erro honesto em vez de fingir
# que a mensagem foi enviada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Endereço que recebe as mensagens do formulário (a confirmar pela empresa).
CONTACTO_DESTINO=
# Remetente apresentado no e-mail. Se vazio, usa-se SMTP_USER.
CONTACTO_REMETENTE=
